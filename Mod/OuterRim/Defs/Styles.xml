      </li>
      <li>
        <thingDef>Dresser</thingDef>
        <styleDef>PAS_Corellian_Dresser</styleDef>
      </li>
      <li>
        <thingDef>EndTable</thingDef>
        <styleDef>PAS_Corellian_EndTable</styleDef>
      </li>
      <li>
        <thingDef>Table2x2c</thingDef>
        <styleDef>PAS_Corellian_Table2x2c</styleDef>
      </li>
