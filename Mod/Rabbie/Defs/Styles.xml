<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Styles tires de « Rabbie The Moonrabbit race » (Runne Latki).

     Ce mod de race embarque un ensemble de mobilier complet, sans rapport avec la race
     elle-meme. Sur ses 41 batiments, une vingtaine ont un jumeau vanilla de meme empreinte.

     DEUX CATEGORIES, meme raison qu'ailleurs : le mod propose deux canapes, deux chaises, deux
     tabourets, deux lampadaires, deux pots et deux bibliotheques.

     NON REPRIS : les postes de production (etabli de couture, table d'usinage, raffinerie), le
     portable qui est un `Building_WorkTable` et son imprimante-facility, les cartons de
     stockage, la fenetre et l'applique qui sont muraux, et le mur - les murs utilisent un
     graphique lie que le systeme de styles ne sait pas remplacer proprement. -->

  <StyleCategoryDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>PAS_Rabbie</defName>
    <label>rabbie</label>
    <fixedIdeoOnly>false</fixedIdeoOnly>
    <thingDefStyles>
      <li>
        <thingDef>Bed</thingDef>
        <styleDef>PAS_Rabbie_Bed</styleDef>
      </li>
      <li>
        <thingDef>DoubleBed</thingDef>
        <styleDef>PAS_Rabbie_DoubleBed</styleDef>
      </li>
      <li>
        <thingDef>Armchair</thingDef>
        <styleDef>PAS_Rabbie_Armchair</styleDef>
      </li>
      <li>
        <thingDef>DiningChair</thingDef>
        <styleDef>PAS_Rabbie_DiningChair</styleDef>
      </li>
      <li>
        <thingDef>Stool</thingDef>
        <styleDef>PAS_Rabbie_Stool</styleDef>
      </li>
      <li>
        <thingDef>Dresser</thingDef>
        <styleDef>PAS_Rabbie_Dresser</styleDef>
      </li>
      <li>
        <thingDef>EndTable</thingDef>
        <styleDef>PAS_Rabbie_EndTable</styleDef>
      </li>
      <li>
        <thingDef>Table2x2c</thingDef>
        <styleDef>PAS_Rabbie_Table2x2c</styleDef>
      </li>
      <li>
        <thingDef>Shelf</thingDef>
        <styleDef>PAS_Rabbie_Shelf</styleDef>
      </li>
      <li>
        <thingDef>StandingLamp</thingDef>
        <styleDef>PAS_Rabbie_StandingLamp</styleDef>
      </li>
      <li>
        <thingDef>PlantPot</thingDef>
        <styleDef>PAS_Rabbie_PlantPot</styleDef>
      </li>
      <li>
        <thingDef>BookcaseSmall</thingDef>
        <styleDef>PAS_Rabbie_BookcaseSmall</styleDef>
      </li>
      <li>
        <thingDef>Door</thingDef>
        <styleDef>PAS_Rabbie_Door</styleDef>
      </li>
    </thingDefStyles>
  </StyleCategoryDef>

