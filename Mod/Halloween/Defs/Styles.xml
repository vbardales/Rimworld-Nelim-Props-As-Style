<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Styles tires de « Hallowen Monster Mash » ([KD] Killer_Diller).

       CAS PARTICULIER : CE MOD EST MORT, ET C'EST JUSTEMENT CE QUI REND LA MANOEUVRE POSSIBLE.
       Il ne declare que la 1.2, n'a aucun LoadFolders.xml, et toutes ses defs vivent dans un
       dossier `1.2/`. En 1.6 RimWorld ne lit que la racine : AUCUNE de ses defs ne se charge.

       Mais ses TEXTURES, elles, sont a la racine - `Textures/Decorations/...` - donc le jeu les
       charge normalement. Un `ThingStyleDef` peut donc pointer dessus et rendre, alors meme que
       l'objet d'origine n'existe plus dans la partie. Verifie : les onze chemins resolvent.

       Rien n'est copie, rien n'est extrait. Il faut simplement etre abonne au mod.

       QUATRE STYLES SEULEMENT, et une seule categorie suffit puisqu'ils visent quatre defs
       vanilla differentes.

       NON REPRIS - les sept autres decorations : araignee, fantomes, chauves-souris, squelette,
       faucheuse, arbre hante, citrouille eteinte. Aucune n'a de jumeau vanilla, et ce sont les
       props les plus purs du corpus : `Beauty 1`, aucun cout, aucun materiau, aucun composant.
       Rien d'autre qu'une image.

       A NOTER SUR LES DEUX LUMIERES : dans le mod d'origine, la citrouille allumee et la bougie
       sont de vrais batiments - Refuelable, Glower de rayon 10, HeatPusher, et meme un focus de
       meditation. En style, tout cela disparait : c'est la torche vanilla et le brasero vanilla
       qui gardent leur comportement, seule l'apparence change. C'est le principe, et ici il
       tombe bien : la torche est deja refuelable et eclairante. -->

  <StyleCategoryDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>PAS_Halloween</defName>
    <label>halloween</label>
    <fixedIdeoOnly>false</fixedIdeoOnly>
    <thingDefStyles>
      <li>
        <thingDef>SculptureSmall</thingDef>
        <styleDef>PAS_Halloween_SculptureSmall</styleDef>
      </li>
      <li>
        <thingDef>TorchLamp</thingDef>
        <styleDef>PAS_Halloween_TorchLamp</styleDef>
      </li>
      <li>
        <thingDef>Campfire</thingDef>
        <styleDef>PAS_Halloween_Campfire</styleDef>
      </li>
      <li>
        <thingDef>Brazier</thingDef>
        <styleDef>PAS_Halloween_Brazier</styleDef>
      </li>
    </thingDefStyles>
  </StyleCategoryDef>

  <!-- La gargouille est litteralement une petite sculpture. -->
  <ThingStyleDef>
    <defName>PAS_Halloween_SculptureSmall</defName>
    <graphicData>
      <texPath>Decorations/Gargoyle/Gargoyle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingStyleDef>

  <!-- La citrouille allumee sur la torche : meme nature, une source de lumiere qu'on alimente. -->
  <ThingStyleDef>
    <defName>PAS_Halloween_TorchLamp</defName>
    <graphicData>
      <texPath>Decorations/JackolanternL/JackolanternL</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingStyleDef>

  <!-- Le chaudron sur le feu de camp : on l'alimente, il chauffe, on y cuisine. -->
  <ThingStyleDef>
    <defName>PAS_Halloween_Campfire</defName>
    <graphicData>
      <texPath>Decorations/Cauldron/Cauldron</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingStyleDef>

  <!-- La bougie sur le brasero. -->
  <ThingStyleDef>
    <defName>PAS_Halloween_Brazier</defName>
    <graphicData>
      <texPath>Decorations/Candle/Candle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingStyleDef>

</Defs>
