<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Styles tires de « Ponpeco Furnitures : Kids' Room » (ponpeco).

     Le mod livre un ensemble de chambre d'enfant complet, deja fonctionnel, et calque
     empreinte par empreinte sur le vanilla. Quatre de ses defs portent meme deja
     `CompProperties_Styleable` - le tabouret, la chaise, la chaise d'enfant et la guirlande :
     l'auteur avait la meme intention.

     DEUX CATEGORIES, parce qu'un thingDef ne recoit qu'un styleDef par categorie et que le mod
     propose plusieurs variantes de la meme piece : deux lits, deux lits d'animal, deux chaises,
     quatre lampes.

     NON REPRIS : la table 1x1 (pas d'equivalent vanilla), la guirlande lumineuse et les deux
     rideaux (muraux), les berceaux Biotech (fonctionnels et sans jumeau), et deux des quatre
     lampes animales, faute d'une troisieme categorie qui se justifie. -->

  <StyleCategoryDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>PAS_PonpecoKids</defName>
    <label>chambre d'enfant</label>
    <fixedIdeoOnly>false</fixedIdeoOnly>
    <thingDefStyles>
      <li>
        <thingDef>Bedroll</thingDef>
        <styleDef>PAS_PonpecoKids_Bedroll</styleDef>
      </li>
      <li>
        <thingDef>Bed</thingDef>
        <styleDef>PAS_PonpecoKids_Bed</styleDef>
      </li>
      <li>
        <thingDef>DoubleBed</thingDef>
        <styleDef>PAS_PonpecoKids_DoubleBed</styleDef>
      </li>
      <li>
        <thingDef>RoyalBed</thingDef>
        <styleDef>PAS_PonpecoKids_RoyalBed</styleDef>
      </li>
      <li>
        <thingDef>AnimalBed</thingDef>
        <styleDef>PAS_PonpecoKids_AnimalBed</styleDef>
      </li>
      <li>
        <thingDef>Stool</thingDef>
        <styleDef>PAS_PonpecoKids_Stool</styleDef>
      </li>
      <li>
        <thingDef>DiningChair</thingDef>
        <styleDef>PAS_PonpecoKids_DiningChair</styleDef>
      </li>
      <li>
        <thingDef>Armchair</thingDef>
        <styleDef>PAS_PonpecoKids_Armchair</styleDef>
      </li>
      <li>
        <thingDef>EndTable</thingDef>
        <styleDef>PAS_PonpecoKids_EndTable</styleDef>
      </li>
      <li>
        <thingDef>Table2x2c</thingDef>
        <styleDef>PAS_PonpecoKids_Table2x2c</styleDef>
      </li>
      <li>
        <thingDef>Dresser</thingDef>
        <styleDef>PAS_PonpecoKids_Dresser</styleDef>
      </li>
      <li>
        <thingDef>StandingLamp</thingDef>
        <styleDef>PAS_PonpecoKids_StandingLamp</styleDef>
      </li>
    </thingDefStyles>
  </StyleCategoryDef>

