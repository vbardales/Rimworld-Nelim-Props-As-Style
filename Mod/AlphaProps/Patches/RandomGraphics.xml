    </match>

    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="StandingLamp"]/comps</xpath>
      <value>
        <li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
          <randomGraphics>
                <li>Things/Building/Furniture/LampStanding</li>
                <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightA</li>
                <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightB</li>
                <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightC</li>
                <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightD</li>
                <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightE</li>
          </randomGraphics>
          <optionalNames>
                <li>Vanilla</li>
                <li>Street light A</li>
                <li>Street light B</li>
                <li>Street light C</li>
                <li>Street light D</li>
                <li>Street light E</li>
          </optionalNames>
        </li>
      </value>
    </nomatch>
  </Operation>

</Patch>
