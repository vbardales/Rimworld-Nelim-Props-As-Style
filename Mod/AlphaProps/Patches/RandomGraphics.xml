          <xpath>Defs/ThingDef[defName="StandingLamp"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/optionalNames</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="StandingLamp"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/optionalNames</xpath>
