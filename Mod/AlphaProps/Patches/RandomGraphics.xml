    <xpath>Defs/ThingDef[defName="StandingLamp"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]</xpath>

    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="StandingLamp"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/randomGraphics</xpath>
          <value>
              <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightA</li>
              <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightB</li>
              <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightC</li>
              <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightD</li>
              <li>Things/Building/ParkProps/Furniture/VFEPD_AP_LamplightE</li>
          </value>
        </li>
        <!-- optionalNames peut manquer si un autre mod a pose le composant sans noms.
             Conditionnel sans nomatch : absent, on ne fait rien et on ne signale pas d'erreur. -->
